DEBUG=True
SECRET_KEY=
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:8000

# Leave empty to use SQLite when running locally with uv.
DATABASE_URL=

# Docker Compose uses these names for its local PostgreSQL container.
POSTGRES_DB=pcm_db
POSTGRES_USER=pcm_user
WEB_PORT=8000

# Optional Supabase Storage configuration for deployments.
USE_SUPABASE_STORAGE=False
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
AWS_S3_ENDPOINT_URL=
AWS_S3_REGION_NAME=
SUPABASE_PROJECT_URL=

SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
